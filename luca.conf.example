server=irc.libera.chat
port=6697
tls=true
nick=LuCa
user=luca
realname=LuCa IRC bot
channel=#luca
script=scripts/ping.lua
sasl=false
# sasl_user=account
# sasl_password=secret
pbmp_socket=/tmp/luca.pbmp.sock
reconnect_seconds=5

# Optional BotAI; omit botai_url for standalone operation
# botai_url=http://botai:8090
botai_expert=auto
botai_timeout_seconds=30
# Optional bounded in-memory context (0 disables history; max 20)
botai_history_messages=10
# Opt-in natural PM / explicit nick-addressed channel conversation
botai_conversation=false
